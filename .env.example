# Server-side only. Copy to .env.local; never commit the real connection string.
DATABASE_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Optional: application database name (defaults to bank).
MONGODB_DB=bank
# Optional, only if your local DNS refuses Atlas SRV lookups:
# MONGODB_DNS_SERVERS=1.1.1.1

# Brevo SMTP, server-side only. Use the SMTP login and SMTP key from Brevo.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
APP_URL=http://localhost:3000
# Random secret of at least 32 characters for the protected retry worker.
CRON_SECRET=

# Admin: no code needed on localhost with next dev. Required on Vercel / production.
# Use a random value of at least 16 characters. Never NEXT_PUBLIC_*.
ADMIN_ACCESS_CODE=
